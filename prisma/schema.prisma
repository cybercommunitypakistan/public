// =============================================================================
// FILE: prisma/schema.prisma
// Cyber Community Pakistan — content database (Supabase Postgres, Prisma 7)
//
// Two kinds of content:
//  1. Lists editors add / remove / reorder → real tables
//     (menu, socials, footer links, programs, events, testimonials, FAQs, team)
//  2. Section copy (headlines, taglines, small lists) → `Section` rows, one per
//     section key, content stored as JSON and validated with zod
//     (see lib/content/schemas.ts for every key and its fields)
// =============================================================================

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Global settings (single row, id = 1) ------------------------------

model SiteSettings {
  id        Int    @id @default(1)
  name      String
  shortName String
  email     String
  /// Ambassador application form (used by many buttons)
  applyUrl  String

  // Optional image logo (Cloudinary URL or /public path). Null = text mark.
  logoUrl           String?
  logoPublicId      String? /// Cloudinary public_id (for replacing/deleting)
  logoAlt           String?
  logoWidth         Int?
  logoHeight        Int?
  logoDisplayHeight Int     @default(34)
  /// true = logo inverts like the header text (white logos); false = keep colours
  logoBlend         Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ---------- Navigation ---------------------------------------------------------

/// Full-screen menu. Top-level items have parentId = null; dropdown links have a parent.
model MenuItem {
  id          String     @id @default(cuid())
  label       String
  href        String? /// '#section', '/page', '/page#section', 'https://…', 'mailto:…'
  description String?
  badge       String?
  order       Int        @default(0)
  visible     Boolean    @default(true)
  parentId    String?
  parent      MenuItem?  @relation("MenuTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    MenuItem[] @relation("MenuTree")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([parentId, order])
}

model SocialLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model FooterLink {
  id        String   @id @default(cuid())
  label     String
  href      String
  order     Int      @default(0)
  visible   Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

// ---------- Section copy ---------------------------------------------------------

/// One row per section, e.g. key = "home.hero". `content` shape is defined in
/// lib/content/schemas.ts and validated on read and on save.
model Section {
  key       String   @id
  content   Json
  updatedAt DateTime @updatedAt
}

// ---------- Home: programs -------------------------------------------------------

enum ProgramStatus {
  OPEN
  COMING_SOON
  ALWAYS_ON
}

enum ProgramArt {
  TERMINAL
  LAB
  MIC
  BADGE
  SHIELD
}

model Program {
  id          String        @id @default(cuid())
  title       String
  level       String
  status      ProgramStatus @default(OPEN)
  description String
  meta        String[]
  ctaLabel    String
  ctaHref     String
  art         ProgramArt    @default(TERMINAL)
  featured    Boolean       @default(false)
  order       Int           @default(0)
  published   Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([published, order])
}

// ---------- Home: events ----------------------------------------------------------

enum EventType {
  LECTURE
  WORKSHOP
  WEBINAR
  MEETUP
}

model Event {
  id          String    @id @default(cuid())
  /// Calendar day (Pakistan time). Past events drop off the home page automatically.
  date        DateTime  @db.Date
  title       String
  type        EventType @default(LECTURE)
  series      String?
  format      String
  description String
  href        String
  published   Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([published, date])
}

// ---------- Home: testimonials & FAQ ------------------------------------------------

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String
  avatarUrl String?
  /// true = sample text (shows a "Sample" tag on the site)
  isSample  Boolean  @default(false)
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, order])
}

// ---------- About: team -----------------------------------------------------------

enum TeamGroup {
  CORE
  LEADS
  ADVISORS
}

model TeamMember {
  id            String    @id @default(cuid())
  name          String
  role          String
  group         TeamGroup @default(CORE)
  city          String?
  photoUrl      String?
  photoPublicId String? /// Cloudinary public_id
  linkedin      String?
  x             String?
  github        String?
  email         String?
  order         Int       @default(0)
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([published, order])
}

// ---------- Admin access (Supabase Auth) -------------------------------------------

enum AdminRole {
  OWNER
  EDITOR
}

/// People allowed into /admin. `id` = Supabase Auth user id (auth.users.id).
model AdminUser {
  id        String    @id @db.Uuid
  email     String    @unique
  name      String?
  role      AdminRole @default(EDITOR)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}
